# Ed25519 private key required by the SDK at startup. Generate with `bun run keygen`.
# PKCS8 DER, base64; keep the private key secret.
FUTURITY_SIGNING_KEY=

PORT=3000

# Published manifest/catalog base URL. Use reachable HTTPS for registration.
# When omitted, defaults to http://localhost:<PORT> (3000 by default).
# PUBLIC_URL=http://localhost:3000

# Trusted upstream configuration; marketplace currently uses this development API.
# Auth and stock data share this URL. Upstream calls begin only when a tool is invoked.
SMIP_MOBILE_URL=https://smipdev.synnexmetrodata.com/mobile

# Organization-configured smip_email/smip_password arrive in X-Futurity-Data-Params, not environment.
